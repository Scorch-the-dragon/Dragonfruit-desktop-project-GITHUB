extends SceneTree
# Run with Godot --headless --path . --script tools/build_reverse_squeaks.gd
# Rebuilds reversed stereo WAVs and their matching loudness curves from the MP3s.
func _initialize():
	var profiles = {}
	for name in ["soft-squeak", "squeaky", "squeaky-toy"]:
		var source = AudioStreamMP3.new()
		source.data = FileAccess.get_file_as_bytes("res://Audio/" + name + "-made-with-Voicemod.mp3")
		var playback = source.instantiate_playback()
		playback.start()
		var rate = int(AudioServer.get_mix_rate())
		var samples = playback.mix_audio(1.0, ceili(source.get_length() * rate))
		samples.reverse()
		var pcm = PackedByteArray()
		pcm.resize(samples.size() * 4)
		var envelope = []
		var slice = int(rate * 0.02)
		var power = 0.0
		var count = 0
		for i in samples.size():
			# Reverse time, keeping the left and right channels in their original order.
			pcm.encode_s16(i * 4, int(clampf(samples[i].x, -1.0, 1.0) * 32767))
			pcm.encode_s16(i * 4 + 2, int(clampf(samples[i].y, -1.0, 1.0) * 32767))
			power += samples[i].length_squared() * 0.5
			count += 1
			if count == slice or i == samples.size() - 1:
				envelope.append(sqrt(power / count))
				count = 0
				power = 0.0
		var peak = maxf(envelope.max(), 0.000001)
		for i in envelope.size():
			envelope[i] /= peak
		var wav = AudioStreamWAV.new()
		wav.format = AudioStreamWAV.FORMAT_16_BITS
		wav.stereo = true
		wav.mix_rate = rate
		wav.data = pcm
		var filename = name + "-reversed.wav"
		assert(wav.save_to_wav("res://Audio/" + filename) == OK)
		profiles[filename] = {"length": float(samples.size()) / rate, "step": 0.02, "envelope": envelope}
	var file = FileAccess.open("res://Audio/ReverseSqueakProfiles.gd", FileAccess.WRITE)
	file.store_string("extends RefCounted\n# Generated by tools/build_reverse_squeaks.gd; loudness in 20ms slices.\nconst DATA = " + JSON.stringify(profiles) + "\n")
	print("Built three reversed squeaks and matching animation profiles.")
	quit()
